<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/bookmarked_story_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/bookmarked_story_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bookmarked Story Title"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/bookmarked_story_image"
        app:layout_constraintEnd_toStartOf="@+id/remove_bookmark_button"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bookmarked_story_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bookmarked Story Description"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@+id/bookmarked_story_image"
        app:layout_constraintEnd_toStartOf="@+id/remove_bookmark_button"
        app:layout_constraintTop_toBottomOf="@+id/bookmarked_story_title" />

    <TextView
        android:id="@+id/bookmarked_story_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="10sp"
        android:textColor="@color/teal_200"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@+id/bookmarked_story_image"
        app:layout_constraintTop_toBottomOf="@+id/bookmarked_story_description" />

    <TextView
        android:id="@+id/bookmarked_story_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By Author"
        android:textSize="10sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@+id/bookmarked_story_image"
        app:layout_constraintTop_toBottomOf="@+id/bookmarked_story_category" />

    <ImageButton
        android:id="@+id/remove_bookmark_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Remove bookmark"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

